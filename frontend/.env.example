# Entropy Frontend Environment Configuration

# Production backend API base URL (defaults to http://localhost:8000/api/v1 if not specified)
# Example: https://api.entropy.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional override for the backend OpenAPI/Swagger docs link
# Example: https://api.entropy.yourdomain.com/docs
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs
