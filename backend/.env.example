# Entropy Environment Configuration
ENTROPY_ALLOW_LOCALHOST_NO_KEY=true

# AI Explanation Settings (Google Gemini)
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM Settings (Ollama / Local Server)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=k2-horizon:7b-q4
